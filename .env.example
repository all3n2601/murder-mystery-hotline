# AssemblyAI API key (server-side only, never sent to the browser)
ASSEMBLYAI_API_KEY=

# Public HTTPS URL that AssemblyAI calls for the engine-as-LLM endpoint.
# Dev: run `ngrok http 8787` and paste the https URL here.
PUBLIC_URL=

# Shared secret AssemblyAI sends as the bearer token to our LLM endpoint.
# Generate with: openssl rand -hex 24
LLM_ENDPOINT_SECRET=

# Model the endpoint uses through the LLM Gateway for suspect replies.
SUSPECT_MODEL=qwen3.5-4b-32k-fast
