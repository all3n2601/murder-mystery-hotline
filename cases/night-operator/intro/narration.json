 "lines": [
  {
   "act": "night",
   "text": "MAdison Exchange.",
   "startMs": 600,
   "endMs": 1685
  },
  {
   "act": "night",
   "text": "Ten past two in the morning, and raining like it meant it.",
   "startMs": 2185,
   "endMs": 5487
  },
  {
   "act": "victim",
   "text": "That's Dot Kowalski.",
   "startMs": 6687,
   "endMs": 8051
  },
  {
   "act": "victim",
   "text": "Night operator, position three.",
   "startMs": 8451,
   "endMs": 10346
  },
  {
   "act": "victim",
   "text": "Every call on this block went through her hands, love, and she listened to more of them than she ought to.",
   "startMs": 11046,
   "endMs": 16579
  },
  {
   "act": "victim",
   "text": "People told Dot things.",
   "startMs": 17179,
   "endMs": 18772
  },
  {
   "act": "victim",
   "text": "And Dot remembered.",
   "startMs": 19272,
   "endMs": 20311
  },
  {
   "act": "scene",
   "text": "I found her slumped at her board, like she'd nodded off.",
   "startMs": 21611,
   "endMs": 24398
  },
  {
   "act": "scene",
   "text": "Haah… She hadn't.",
   "startMs": 24898,
   "endMs": 26835
  },
  {
   "act": "scene",
   "text": "Strangled with one of her own patch cords.",
   "startMs": 27735,
   "endMs": 30060
  },
  {
   "act": "scene",
   "text": "The police are keeping that quiet, so you keep it under your hat.",
   "startMs": 30660,
   "endMs": 34187
  },
  {
   "act": "scene",
   "text": "Anybody else who knows it was there.",
   "startMs": 34687,
   "endMs": 36591
  },
  {
   "act": "suspects",
   "text": "Four lines lit up on her board tonight.",
   "startMs": 37991,
   "endMs": 39928
  },
  {
   "act": "suspects",
   "text": "Frank Doyle. Runs the night desk at the Hotel Marlowe, right across the street. Dot put his calls through every night. Smooth as a new dime. Heh heh.",
   "suspect": "doyle",
   "startMs": 40728,
   "endMs": 50747
  },
  {
   "act": "suspects",
   "text": "Evelyn Ashford. A society widow. Rings long-distance every night at half past one, regular as church.",
   "suspect": "evelyn",
   "startMs": 51647,
   "endMs": 58862
  },
  {
   "act": "suspects",
   "text": "Leo Brandt. Crime reporter at the Herald. Dot sold him tips off the lines.",
   "suspect": "leo",
   "startMs": 59762,
   "endMs": 64574
  },
  {
   "act": "suspects",
   "text": "Officer Tom Riley. Walks the beat outside. Dot's ex-fiancé. She gave him back the ring last month.",
   "suspect": "riley",
   "startMs": 65474,
   "endMs": 73027
  },
  {
   "act": "log",
   "text": "Here's her log.",
   "startMs": 74327,
   "endMs": 75312
  },
  {
   "act": "log",
   "text": "Every call she put through tonight, and when.",
   "startMs": 75712,
   "endMs": 78098
  },
  {
   "act": "log",
   "text": "Somebody's story won't fit it.",
   "startMs": 78598,
   "endMs": 80245
  },
  {
   "act": "log",
   "text": "And after one thirty-eight, the handwriting isn't hers.",
   "startMs": 80845,
   "endMs": 84376
  },
  {
   "act": "job",
   "text": "You've got twenty-five questions before the switchboard cuts you off.",
   "startMs": 85776,
   "endMs": 89130
  },
  {
   "act": "job",
   "text": "Ring them. Push them. Catch them out.",
   "startMs": 89630,
   "endMs": 92022
  },
  {
   "act": "job",
   "text": "When you know who, and you can prove it, file the charge.",
   "startMs": 92622,
   "endMs": 95969
  },
  {
   "act": "job",
   "text": "Plug in, love.",
   "startMs": 96669,
   "endMs": 97941
  },
  {
   "act": "job",
   "text": "Start asking.",
   "startMs": 98341,
   "endMs": 99304
  }
 ],
